# Copie este arquivo para "backend/.env" e preencha. O .env NÃO vai para o GitHub.

# Banco de dados. Deixe vazio para usar SQLite local (backend/frequencia.db).
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (porta 6543).
# DATABASE_URL=postgresql://postgres.xxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Login do sistema (senha com 6 dígitos)
ADMIN_EMAIL=admin@frequencia.com
ADMIN_SENHA=123456

# Chave para assinar os tokens de login. Em produção, use um texto longo e aleatório.
SECRET_KEY=troque-esta-chave-em-producao

# Endereço do front-end permitido (ex.: https://frequencia-mais.vercel.app). "*" libera todos.
CORS_ORIGINS=*
